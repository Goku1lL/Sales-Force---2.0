{
  "name": "@sfa/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --transpile-only --respawn src/server.ts",
    "build": "tsc -p tsconfig.json --noEmitOnError",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema=../../prisma/schema.prisma"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "prisma": "^5.19.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.10",
    "rate-limiter-flexible": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
