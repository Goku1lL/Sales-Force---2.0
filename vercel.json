{
  "version": 2,
  "buildCommand": "pnpm install && pnpm run build",
  "outputDirectory": "apps/frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth" },
    { "source": "/api/dashboard/(.*)", "destination": "/api/dashboard" },
    { "source": "/api/leaderboard/(.*)", "destination": "/api/leaderboard" },
    { "source": "/api/targets/(.*)", "destination": "/api/targets" },
    { "source": "/api/customers/(.*)", "destination": "/api/customers" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
