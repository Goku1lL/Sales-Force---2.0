{
  "version": 2,
  "buildCommand": "npx prisma generate && pnpm install && pnpm --filter @sfa/shared build && pnpm run build",
  "devCommand": "cd apps/frontend && pnpm dev",
  "outputDirectory": "apps/frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
