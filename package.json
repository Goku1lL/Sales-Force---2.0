{
  "name": "sfa-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @sfa/frontend dev",
    "build": "pnpm --filter @sfa/frontend build",
    "start": "pnpm --filter @sfa/frontend preview",
    "lint": "echo \"No lint at root\"",
    "vercel-build": "pnpm install && pnpm run build"
  }
}
