{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["../../node_modules/@types"],
    "types": ["node", "express", "cors", "bcrypt", "jsonwebtoken", "nodemailer"]
  },
  "include": ["src", "../../node_modules/@types/**/*"]
}
