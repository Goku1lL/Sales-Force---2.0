{
  "name": "sfa-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "cd apps/backend && npm install && npm run build",
    "start": "cd apps/backend && npm start",
    "lint": "echo \"No lint at root\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@sfa/shared": "workspace:*",
    "@types/node": "^20.0.0",
    "@vercel/node": "^3.2.29",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.10",
    "prisma": "^5.22.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^7.0.2"
  }
}
